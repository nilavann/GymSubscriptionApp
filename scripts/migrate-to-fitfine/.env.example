# Copy to .env (git-ignored) and fill in. A variable already set in the shell wins over this file,
# so the service-role keys can be exported instead of written here.
# DB URLs: the direct URL (db.<ref>.supabase.co:5432) or the session pooler
# (postgres.<ref>@aws-0-<region>.pooler.supabase.com:5432). The transaction pooler (6543) is refused.

# Current project, only ever read.
SOURCE_DB_URL=postgresql://postgres:PASSWORD@db.OLD_REF.supabase.co:5432/postgres
# New project (the scratch project while testing).
TARGET_DB_URL=postgresql://postgres:PASSWORD@db.NEW_REF.supabase.co:5432/postgres
TARGET_SCHEMA=fitfine

# Only for --photos and --validate (Storage API).
SOURCE_SUPABASE_URL=https://OLD_REF.supabase.co
# Used for reads only (download, signed URL).
SOURCE_SERVICE_ROLE_KEY=
TARGET_SUPABASE_URL=https://NEW_REF.supabase.co
TARGET_SERVICE_ROLE_KEY=
PHOTO_BUCKET=member-photos

# Only for tests/run-all.sh: must equal the target ref, so the sabotage tests can never run
# against the real new project.
MIG_TEST_TARGET_REF=
